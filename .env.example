# Пример переменных окружения. Реальные значения кладутся в .env
# на сервере и НИКОГДА не попадают в репозиторий (CLAUDE.md §17).
# Скопировать: cp .env.example .env

# --- Почта: приём заявок с сайта -------------------------------------------
# Mail.ru требует отдельный пароль для внешних приложений
# (Настройки → Безопасность → Пароли для внешних приложений).
SMTP_HOST=smtp.mail.ru
SMTP_PORT=465
SMTP_USER=pravstrateg@mail.ru
SMTP_PASSWORD=
# Куда приходят заявки
MAIL_TO=pravstrateg@mail.ru
# От чьего имени отправляется письмо (обычно совпадает с SMTP_USER)
MAIL_FROM=pravstrateg@mail.ru

# --- Telegram: дублирующее уведомление о заявке ----------------------------
# Токен выдаёт @BotFather. chat_id можно узнать у @userinfobot,
# предварительно написав своему боту любое сообщение.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Аналитика --------------------------------------------------------------
# Номер счётчика Яндекс.Метрики. Счётчик загружается ТОЛЬКО после согласия
# пользователя в cookie-баннере — см. п. 9.2 политики обработки ПД.
# Если переменная пуста, аналитика не подключается вовсе.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
