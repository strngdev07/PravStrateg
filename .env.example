# Пример переменных окружения. Реальные значения кладутся в .env
# и НИКОГДА не попадают в репозиторий (CLAUDE.md §17).
# Скопировать: cp .env.example .env

# --- Telegram: канал уведомлений о заявках -----------------------------------
# Токен выдаёт @BotFather. Бот проекта — @pravstrateg_bot.
TELEGRAM_BOT_TOKEN=

# Получатели уведомлений. Можно указать несколько через запятую:
#   TELEGRAM_CHAT_ID=123456789,987654321
# ВАЖНО: каждый получатель должен сам открыть чат с ботом и нажать «Запустить».
# Telegram запрещает ботам писать первыми: без этого шага уведомления
# не придут даже при полностью верных настройках.
# Вместо личных чатов можно указать один общий групповой чат с ботом —
# его идентификатор отрицательный, вида -1001234567890.
TELEGRAM_CHAT_ID=

# --- Аналитика ---------------------------------------------------------------
# Номер счётчика Яндекс.Метрики. Счётчик загружается ТОЛЬКО после согласия
# пользователя в cookie-баннере — см. п. 9.2 политики обработки ПД.
# Если переменная пуста, аналитика не подключается вовсе.
NEXT_PUBLIC_YANDEX_METRIKA_ID=
